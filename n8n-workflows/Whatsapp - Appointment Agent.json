    {
      "parameters": {
        "jsCode": "// Extract data from webhook\nconst body = $input.item.json.body;\nconst query = $input.item.json.query;\n\n// Handle Meta Webhook verification (GET request)\nif (query && query['hub.mode'] === 'subscribe') {\n  const verifyToken = query['hub.verify_token'];\n  const challenge = query['hub.challenge'];\n\n  // Verify token must match\n  if (verifyToken === 'appointment_manager_verify_2026') {\n    return {\n      json: {\n        verification: true,\n        challenge: challenge\n      }\n    };\n  } else {\n    throw new Error('Invalid verify token');\n  }\n}\n\n// Verify if it's a text message (POST request)\nif (body && body.entry && body.entry[0].changes && body.entry[0].changes[0].value.messages) {\n  const message = body.entry[0].changes[0].value.messages[0];\n  const contact = body.entry[0].changes[0].value.contacts[0];\n\n  // Extract information\n  const phoneNumber = message.from;\n  const messageText =message.text?.body || '';\n  const messageId = message.id;\n  const contactName = contact.profile?.name || 'Usuario';\n\n\n  // Prepare payload for agent-core\n  return {\n    json: {\n      conversation_id: `whatsapp_${phoneNumber}`,\n      message: messageText,\n      metadata: {\n        channel: 'whatsapp',\n        phone_number: phoneNumber,\n        contact_name: contactName,\n        message_id: messageId,\n        timestamp: message.timestamp\n      }\n    }\n  };\n}\n\n// Unsupported message type\nreturn {\n  json: {\n    error: 'Unsupported message type'\n  }\n};"
      },
