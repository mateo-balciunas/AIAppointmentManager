# =============================================================================
# ENVIROMENT CONFIGURATION - AIAppointmentManager v2.0.0
# =============================================================================


# -----------------------------------------------------------------------------
# n8n Channel Orchestrator
# -----------------------------------------------------------------------------


# Public domain where n8n will be accessible (used by Caddy and webhooks)
# Example: n8n.yourdomain.com
# Development example: tunnel URL from ngrok or localtunnel
N8N_HOST=

# n8n intern database password (generated by: openssl rand -hex 24)
N8N_DB_PASSWORD=

# Encrypted n8n key (generated by: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# n8n JWT secret key (generated by: openssl rand -hex 32)
N8N_JWT_SECRET=


# -----------------------------------------------------------------------------
# agent-core  - Typescrpt agent service
# -----------------------------------------------------------------------------


# Shared token between n8n and agent-core (generated by: openssl rand -hex 32)
AGENT_CORE_TOKEN=


# -----------------------------------------------------------------------------
# Supabase - Database
# -----------------------------------------------------------------------------

# Supabase Proyect URL (Settings -> API -> Project URL)
# Example: https://your-project.supabase.co
SUPABASE_URL=

# Service Role Key (Settings -> API -> Service Role Key)
SUPABASE_SERVICE_ROLE_KEY=

# Connection String to Postgres, for advisory locks (Settings -> Database -> Connection String)
# Must begin with postgres:// or postgresql://
SUPABASE_DB_URL=


# -----------------------------------------------------------------------------
# LLM - AI Provider
# -----------------------------------------------------------------------------

# Default provider: anthropic, gemini or openai
LLM_DEFAULT_PROIVDER=

# Model to use (examples: claude-sonnet-4-20250514, gemini-2.0-flash-exp, gpt-4o)
LLM_DEFAULT_MODEL=

# Fallback provider (optional)
LLM_FALLBACK_PROVIDER=

# API keys for providers (only default provider is required)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Iteration limit for tool calling (default: 6)
MAX_TOOL_ITERATIONS=6



# -----------------------------------------------------------------------------
# Meta (Whatsapp and Instagram)
# -----------------------------------------------------------------------------

# App Secret from Meta application (Meta App -> Settings -> Basic)
# Used to verify HMAC signature of webhooks
META_APP_SECRET=

# Verify Token (User must create, must be same as the one registered in Meta App)
META_VERIFY_TOKEN=

# Whatsapp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Instagram
IG_PAGE_TOKEN=


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------

# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=

# Secret token to verify webhooks (generated by: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Google Calendar
# -----------------------------------------------------------------------------


# JSON from Service Account (Google Cloud (base 64))
# Generates the SA in GCP, download JSON file, and convert to base 64
# cat sercice-account.json | base54 -w 0
GOOGLE_SA_JSON=

# Calendar ID (Settings -> Integrate Calendar)
GOOGLE_CALENDAR_ID=


# -----------------------------------------------------------------------------
# Regional Configuration
# -----------------------------------------------------------------------------

# Business timezone (example: America/New_York)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BUSINESS_TIMEZONE=
